@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid vsc-admin-dashboard">

    <!-- Dashboard Header -->
    <div class="vsc-admin-header">
        <div>
            <span class="vsc-admin-eyebrow">
                <i class="bi bi-grid-1x2-fill me-1"></i> ADMINISTRATION
            </span>
            <h1>Admin Dashboard</h1>
            <p>Welcome back, @User.Identity?.Name. Here's your service center overview.</p>
        </div>

        <div class="vsc-admin-user-badge">
            <div class="vsc-admin-avatar">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <strong>Administrator</strong>
                <span>Management Portal</span>
            </div>
            <i class="bi bi-patch-check-fill vsc-admin-verified"></i>
        </div>
    </div>

    <!-- Statistics -->
    <div class="vsc-admin-section-title">
        <div>
            <h2>Dashboard Overview</h2>
            <p>Monitor your service center at a glance.</p>
        </div>
        <span class="vsc-admin-live-label">
            <span></span> System Overview
        </span>
    </div>

    <div class="row g-3 g-xl-4 vsc-admin-stats">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="vsc-admin-stat-card">
                <div class="vsc-admin-stat-top">
                    <div class="vsc-admin-stat-icon vsc-stat-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="vsc-admin-stat-caption">CUSTOMERS</span>
                </div>
                <div class="vsc-admin-stat-value">@ViewBag.TotalCustomers</div>
                <div class="vsc-admin-stat-description">Registered customers</div>
                <div class="vsc-admin-stat-footer">
                    <i class="bi bi-person-check"></i>
                    Customer accounts
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="vsc-admin-stat-card">
                <div class="vsc-admin-stat-top">
                    <div class="vsc-admin-stat-icon vsc-stat-purple">
                        <i class="bi bi-tools"></i>
                    </div>
                    <span class="vsc-admin-stat-caption">MECHANICS</span>
                </div>
                <div class="vsc-admin-stat-value">@ViewBag.TotalMechanics</div>
                <div class="vsc-admin-stat-description">Registered mechanics</div>
                <div class="vsc-admin-stat-footer">
                    <i class="bi bi-person-gear"></i>
                    Service team
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="vsc-admin-stat-card">
                <div class="vsc-admin-stat-top">
                    <div class="vsc-admin-stat-icon vsc-stat-cyan">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <span class="vsc-admin-stat-caption">VEHICLES</span>
                </div>
                <div class="vsc-admin-stat-value">@ViewBag.TotalVehicles</div>
                <div class="vsc-admin-stat-description">Registered vehicles</div>
                <div class="vsc-admin-stat-footer">
                    <i class="bi bi-car-front"></i>
                    Vehicle records
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="vsc-admin-stat-card">
                <div class="vsc-admin-stat-top">
                    <div class="vsc-admin-stat-icon vsc-stat-orange">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <span class="vsc-admin-stat-caption">PENDING SERVICES</span>
                </div>
                <div class="vsc-admin-stat-value">@ViewBag.PendingServices</div>
                <div class="vsc-admin-stat-description">Services awaiting completion</div>
                <div class="vsc-admin-stat-footer">
                    <i class="bi bi-hourglass-split"></i>
                    Work in queue
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="vsc-admin-stat-card">
                <div class="vsc-admin-stat-top">
                    <div class="vsc-admin-stat-icon vsc-stat-green">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <span class="vsc-admin-stat-caption">COMPLETED SERVICES</span>
                </div>
                <div class="vsc-admin-stat-value">@ViewBag.CompletedServices</div>
                <div class="vsc-admin-stat-description">Successfully completed</div>
                <div class="vsc-admin-stat-footer">
                    <i class="bi bi-check2-circle"></i>
                    Finished services
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="vsc-admin-stat-card">
                <div class="vsc-admin-stat-top">
                    <div class="vsc-admin-stat-icon vsc-stat-pink">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <span class="vsc-admin-stat-caption">TOTAL BILLS</span>
                </div>
                <div class="vsc-admin-stat-value">@ViewBag.TotalBills</div>
                <div class="vsc-admin-stat-description">Generated service bills</div>
                <div class="vsc-admin-stat-footer">
                    <i class="bi bi-wallet2"></i>
                    Billing records
                </div>
            </div>
        </div>

    </div>

    <!-- Management -->
    <div class="vsc-admin-section-title vsc-admin-management-title">
        <div>
            <h2>Manage Your System</h2>
            <p>Quick access to your service center operations.</p>
        </div>
    </div>

    <div class="row g-3 g-xl-4">

        <!-- Mechanics -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="vsc-admin-module-card">
                <div class="vsc-admin-module-top">
                    <div class="vsc-admin-module-icon vsc-module-purple">
                        <i class="bi bi-tools"></i>
                    </div>
                    <span class="vsc-admin-module-number">01</span>
                </div>
                <h3>Mechanics</h3>
                <p>Create and manage mechanics who handle customer service requests.</p>
                <a asp-controller="Mechanic" asp-action="Index" class="vsc-admin-module-link">
                    <span>Manage Mechanics</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

        <!-- Customers -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="vsc-admin-module-card">
                <div class="vsc-admin-module-top">
                    <div class="vsc-admin-module-icon vsc-module-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="vsc-admin-module-number">02</span>
                </div>
                <h3>Customers</h3>
                <p>Create and manage customer accounts, contact details, and information.</p>
                <a asp-controller="Customer" asp-action="Index" class="vsc-admin-module-link">
                    <span>Manage Customers</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

        <!-- Vehicles -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="vsc-admin-module-card">
                <div class="vsc-admin-module-top">
                    <div class="vsc-admin-module-icon vsc-module-cyan">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <span class="vsc-admin-module-number">03</span>
                </div>
                <h3>Vehicles</h3>
                <p>Manage customer vehicles, registration numbers, models, and reported issues.</p>
                <a asp-controller="Vehicle" asp-action="Index" class="vsc-admin-module-link">
                    <span>Manage Vehicles</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

        <!-- Service Requests -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="vsc-admin-module-card">
                <div class="vsc-admin-module-top">
                    <div class="vsc-admin-module-icon vsc-module-orange">
                        <i class="bi bi-wrench-adjustable-circle"></i>
                    </div>
                    <span class="vsc-admin-module-number">04</span>
                </div>
                <h3>Service Requests</h3>
                <p>Create service requests, assign mechanics, and monitor service progress.</p>
                <a asp-controller="ServiceRequest" asp-action="Index" class="vsc-admin-module-link">
                    <span>Manage Services</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

        <!-- Bills -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="vsc-admin-module-card">
                <div class="vsc-admin-module-top">
                    <div class="vsc-admin-module-icon vsc-module-green">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <span class="vsc-admin-module-number">05</span>
                </div>
                <h3>Bills & Payments</h3>
                <p>Manage service charges, generate bills, and review payment status.</p>
                <a asp-controller="Bill" asp-action="Index" class="vsc-admin-module-link">
                    <span>Manage Bills</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

    </div>

    <!-- Administrator Information -->
    <div class="vsc-admin-notice">
        <div class="vsc-admin-notice-icon">
            <i class="bi bi-info-lg"></i>
        </div>
        <div>
            <h3>Administrator Access</h3>
            <p>
                You can manage customers, mechanics, vehicles, service requests,
                and billing from this dashboard. Use the management sections above
                to keep your service center records organized.
            </p>
        </div>
    </div>

</div>
