@model Vehicle_Service_Center.ViewModels.CreateBillViewModel

@{
    ViewData["Title"] = "Create Bill";
}

<div class="container mt-4">

    <h2 class="mb-4">Create Bill</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="ServiceRequestId"
                   class="form-label">
            </label>

            <select asp-for="ServiceRequestId"
                    asp-items="Model.ServiceRequests"
                    class="form-select">

                <option value="">
                    -- Select Service Request --
                </option>

            </select>

            <span asp-validation-for="ServiceRequestId"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="SparePartCharge"
                   class="form-label">
            </label>

            <input asp-for="SparePartCharge"
                   class="form-control"
                   type="number"
                   min="0"
                   step="0.01" />

            <span asp-validation-for="SparePartCharge"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="LabourCharge"
                   class="form-label">
            </label>

            <input asp-for="LabourCharge"
                   class="form-control"
                   type="number"
                   min="0"
                   step="0.01" />

            <span asp-validation-for="LabourCharge"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="PaymentType"
                   class="form-label">
            </label>

            <select asp-for="PaymentType"
                    class="form-select">

                <option value="">
                    -- Select Payment Type --
                </option>

                <option value="Cash">
                    Cash
                </option>

                <option value="Card">
                    Card
                </option>

                <option value="UPI">
                    UPI
                </option>

            </select>

            <span asp-validation-for="PaymentType"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="PaymentStatus"
                   class="form-label">
            </label>

            <select asp-for="PaymentStatus"
                    class="form-select">

                <option value="Pending">
                    Pending
                </option>

                <option value="Paid">
                    Paid
                </option>

            </select>

            <span asp-validation-for="PaymentStatus"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Create Bill
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}