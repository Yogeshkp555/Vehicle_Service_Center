
@model List<Vehicle_Service_Center.Models.Bill>

@{
    ViewData["Title"] = "My Bills";
}

<div class="container-fluid py-2">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <span class="text-primary fw-semibold small">
                CUSTOMER PANEL
            </span>

            <h2 class="mt-1 mb-1">My Bills</h2>

            <p class="text-muted mb-0">
                View your service charges and payment information.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="CustomerDashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Dashboard
            </a>
        </div>

    </div>


    <!-- Bill Summary -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-4">
            <div class="vsc-service-summary">
                <div class="vsc-summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <div class="text-muted small">Total Bills</div>
                    <h3 class="mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="vsc-service-summary">
                <div class="vsc-summary-icon vsc-summary-green">
                    <i class="bi bi-currency-rupee"></i>
                </div>

                <div>
                    <div class="text-muted small">Total Amount</div>
                    <h3 class="mb-0">
                        ₹@Model.Sum(b => b.TotalAmount).ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="vsc-service-summary">
                <div class="vsc-summary-icon vsc-summary-orange">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div>
                    <div class="text-muted small">Pending Payments</div>
                    <h3 class="mb-0">
                        @Model.Count(b => b.PaymentStatus != "Paid")
                    </h3>
                </div>
            </div>
        </div>

    </div>


    <!-- Bills Table -->
    @if (!Model.Any())
    {
        <div class="vsc-empty-state text-center">

            <div class="vsc-empty-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>

            <h5>No Bills Found</h5>

            <p class="text-muted mb-0">
                You don't have any service bills yet.
                Your bills will appear here once they are created.
            </p>

        </div>
    }
    else
    {
        <div class="card vsc-table-card">

            <div class="card-header bg-white py-3">

                <h5 class="mb-1">
                    <i class="bi bi-receipt text-primary me-2"></i>
                    Your Service Bills
                </h5>

                <p class="text-muted small mb-0">
                    Review your service charges and payment status.
                </p>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="vsc-table-header">
                        <tr>
                            <th class="ps-4">Vehicle Number</th>
                            <th>Service Description</th>
                            <th>Spare Part Charge</th>
                            <th>Labour Charge</th>
                            <th>Total Amount</th>
                            <th>Payment Type</th>
                            <th>Payment Status</th>
                            <th class="pe-4">Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var bill in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="vsc-vehicle-row-icon">
                                            <i class="bi bi-car-front-fill"></i>
                                        </span>

                                        <strong>
                                            @bill.VehicleNumberPlate
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <div class="vsc-service-description">
                                        @bill.ServiceDescription
                                    </div>
                                </td>

                                <td class="text-nowrap">
                                    ₹@bill.SparePartCharge.ToString("N2")
                                </td>

                                <td class="text-nowrap">
                                    ₹@bill.LabourCharge.ToString("N2")
                                </td>

                                <td class="text-nowrap">
                                    <strong class="vsc-bill-total">
                                        ₹@bill.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @bill.PaymentType
                                    </span>
                                </td>

                                <td>
                                    @if (bill.PaymentStatus == "Paid")
                                    {
                                        <span class="badge vsc-status-completed">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge vsc-status-pending">
                                            <i class="bi bi-clock me-1"></i>
                                            @bill.PaymentStatus
                                        </span>
                                    }
                                </td>

                                <td class="pe-4 text-nowrap">
                                    <i class="bi bi-calendar3 text-muted me-1"></i>
                                    @bill.CreatedAt.ToString("dd-MM-yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr class="vsc-bills-footer">
                            <td colspan="4" class="text-end">
                                <strong>Grand Total</strong>
                            </td>

                            <td colspan="4">
                                <strong class="vsc-bill-total">
                                    ₹@Model.Sum(b => b.TotalAmount).ToString("N2")
                                </strong>
                            </td>
                        </tr>
                    </tfoot>

                </table>

            </div>

            <div class="card-footer bg-white text-muted small py-3">
                Showing @Model.Count bill(s)
            </div>

        </div>
    }

</div>
