@model List<Vehicle_Service_Center.Models.ServiceRequest>

@{
    ViewData["Title"] = "My Services";
}

<div class="container-fluid py-2">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <span class="text-primary fw-semibold small">
                CUSTOMER PANEL
            </span>

            <h2 class="mt-1 mb-1">My Services</h2>

            <p class="text-muted mb-0">
                Track your service requests and their current status.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="CustomerDashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Service Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-4">
            <div class="vsc-service-summary">
                <div class="vsc-summary-icon">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Services</div>
                    <h3 class="mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="vsc-service-summary">
                <div class="vsc-summary-icon vsc-summary-orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="text-muted small">Pending Services</div>
                    <h3 class="mb-0">
                        @Model.Count(s => s.Status == "Pending")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="vsc-service-summary">
                <div class="vsc-summary-icon vsc-summary-green">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small">Completed Services</div>
                    <h3 class="mb-0">
                        @Model.Count(s => s.Status == "Completed")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Service Requests -->
    @if (!Model.Any())
    {
        <div class="vsc-empty-state text-center">
            <div class="vsc-empty-icon">
                <i class="bi bi-clipboard-x"></i>
            </div>

            <h5>No Service Requests Found</h5>

            <p class="text-muted mb-0">
                You don't have any service requests yet.
                Please contact the administrator for assistance.
            </p>
        </div>
    }
    else
    {
        <div class="card vsc-table-card">

            <div class="card-header bg-white py-3">
                <h5 class="mb-1">
                    <i class="bi bi-wrench-adjustable-circle text-primary me-2"></i>
                    Your Service Requests
                </h5>

                <p class="text-muted small mb-0">
                    View service details, assigned mechanics and progress.
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="vsc-table-header">
                        <tr>
                            <th class="ps-4">Vehicle Number</th>
                            <th>Service Description</th>
                            <th>Assigned Mechanic</th>
                            <th>Status</th>
                            <th class="pe-4">Created Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var service in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="vsc-vehicle-row-icon">
                                            <i class="bi bi-car-front-fill"></i>
                                        </span>

                                        <strong>
                                            @(service.Vehicle?.VehicleNumberPlate ?? "N/A")
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <div class="vsc-service-description">
                                        @service.ServiceDescription
                                    </div>
                                </td>

                                <td>
                                    @if (service.Mechanic != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="vsc-mechanic-icon">
                                                <i class="bi bi-person-fill"></i>
                                            </span>

                                            <span>@service.Mechanic.FullName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-person-dash me-1"></i>
                                            Not Assigned
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (service.Status == "Completed")
                                    {
                                        <span class="badge vsc-status-completed">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Completed
                                        </span>
                                    }
                                    else if (service.Status == "InProgress")
                                    {
                                        <span class="badge vsc-status-progress">
                                            <i class="bi bi-arrow-repeat me-1"></i>
                                            In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge vsc-status-pending">
                                            <i class="bi bi-clock me-1"></i>
                                            @service.Status
                                        </span>
                                    }
                                </td>

                                <td class="pe-4 text-nowrap">
                                    <i class="bi bi-calendar3 text-muted me-1"></i>
                                    @service.CreatedAt.ToString("dd-MM-yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="card-footer bg-white text-muted small py-3">
                Showing @Model.Count service request(s)
            </div>

        </div>
    }

</div>
