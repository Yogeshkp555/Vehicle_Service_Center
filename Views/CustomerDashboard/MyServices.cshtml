@model List<Vehicle_Service_Center.Models.ServiceRequest>

@{
    ViewData["Title"] = "My Services";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Services</h2>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No service requests found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Vehicle Number</th>
                        <th>Service Description</th>
                        <th>Assigned Mechanic</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var service in Model)
                    {
                        <tr>
                            <td>
                                @(service.Vehicle?.VehicleNumberPlate ?? "N/A")
                            </td>

                            <td>
                                @service.ServiceDescription
                            </td>

                            <td>
                                @(service.Mechanic?.FullName ?? "Not Assigned")
                            </td>

                            <td>
                                @if (service.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else if (service.Status == "InProgress")
                                {
                                    <span class="badge bg-warning text-dark">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @service.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @service.CreatedAt.ToString("dd-MM-yyyy")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>