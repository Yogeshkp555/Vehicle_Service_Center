
@model List<Vehicle_Service_Center.Models.Vehicle>

@{
    ViewData["Title"] = "My Vehicles";
}

<div class="container-fluid py-2">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <span class="text-primary fw-semibold small">
                CUSTOMER PANEL
            </span>

            <h2 class="mt-1 mb-1">My Vehicles</h2>

            <p class="text-muted mb-0">
                View your registered vehicles and their details.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="CustomerDashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Dashboard
            </a>
        </div>

    </div>


    <!-- Vehicle Count -->
    <div class="vsc-vehicles-summary mb-4">
        <div class="vsc-summary-icon">
            <i class="bi bi-car-front-fill"></i>
        </div>

        <div>
            <div class="text-muted small">Registered Vehicles</div>
            <h3 class="mb-0">@Model.Count</h3>
        </div>
    </div>


    <!-- Vehicle List -->
    @if (!Model.Any())
    {
        <div class="vsc-empty-state text-center">
            <div class="vsc-empty-icon">
                <i class="bi bi-car-front"></i>
            </div>

            <h5>No Vehicles Found</h5>

            <p class="text-muted mb-0">
                You don't have any registered vehicles yet.
                Please contact the administrator for assistance.
            </p>
        </div>
    }
    else
    {
        <div class="card vsc-table-card">

            <div class="card-header bg-white py-3">
                <h5 class="mb-1">
                    <i class="bi bi-list-ul text-primary me-2"></i>
                    Your Registered Vehicles
                </h5>

                <p class="text-muted small mb-0">
                    Vehicle information registered under your account.
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="vsc-table-header">
                        <tr>
                            <th class="ps-4">Vehicle Number</th>
                            <th>Type</th>
                            <th>Brand</th>
                            <th>Model</th>
                            <th class="pe-4">Issue</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var vehicle in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="vsc-vehicle-row-icon">
                                            <i class="bi bi-car-front-fill"></i>
                                        </span>

                                        <strong>
                                            @vehicle.VehicleNumberPlate
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @vehicle.VehicleType
                                    </span>
                                </td>

                                <td>@vehicle.VehicleBrand</td>

                                <td>@vehicle.VehicleModel</td>

                                <td class="pe-4">
                                    @(string.IsNullOrWhiteSpace(vehicle.Issue)
                                        ? "-"
                                        : vehicle.Issue)
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="card-footer bg-white text-muted small py-3">
                Showing @Model.Count vehicle(s)
            </div>

        </div>
    }

</div>
