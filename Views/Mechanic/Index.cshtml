@model IEnumerable<Vehicle_Service_Center.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Mechanics";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Mechanics</h2>
            <p class="text-muted">
                Create and manage mechanics.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Add Mechanic
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No mechanics found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">

                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var mechanic in Model)
                    {
                        <tr>
                            <td>@mechanic.FullName</td>
                            <td>@mechanic.Email</td>
                            <td>@mechanic.PhoneNumber</td>
                            <td>@mechanic.Address</td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@mechanic.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@mechanic.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this mechanic?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>