@{
    ViewData["Title"] = "Mechanic Dashboard";
}

<div class="container-fluid py-2">

    <!-- ================= HEADER ================= -->

    <div class="d-flex flex-column flex-md-row justify-content-between
        align-items-md-center mb-4">

        <div>

            <span class="text-primary fw-semibold small">
                MECHANIC PANEL
            </span>

            <h2 class="mt-1 mb-1">
                Mechanic Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome back, @User.Identity?.Name
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <span class="badge bg-light text-dark border px-3 py-2">

                <i class="bi bi-tools text-primary me-1"></i>

                Mechanic

            </span>

        </div>

    </div>


    <!-- ================= WELCOME CARD ================= -->

    <div class="vsc-role-banner mb-4">

        <div class="vsc-role-banner-icon">

            <i class="bi bi-tools"></i>

        </div>

        <div>

            <h4 class="mb-1">
                Ready to manage your services?
            </h4>

            <p class="mb-0">
                View your profile and manage the service requests
                assigned to you.
            </p>

        </div>

    </div>


    <!-- ================= OPTIONS ================= -->

    <div class="mb-3">

        <span class="text-primary fw-semibold small">
            QUICK ACCESS
        </span>

        <h4 class="mt-1">
            Manage Your Work
        </h4>

        <p class="text-muted">
            Access your profile and assigned service requests.
        </p>

    </div>


    <div class="row g-4">


        <!-- MY PROFILE -->

        <div class="col-md-6">

            <div class="vsc-role-card h-100">

                <div class="vsc-role-card-icon">

                    <i class="bi bi-person-circle"></i>

                </div>

                <div class="vsc-role-card-content">

                    <h5>
                        My Profile
                    </h5>

                    <p>
                        View your personal information such as
                        name, email, mobile number and address.
                    </p>

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-primary">

                        <i class="bi bi-person me-1"></i>

                        My Profile

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- MY SERVICES -->

        <div class="col-md-6">

            <div class="vsc-role-card h-100">

                <div class="vsc-role-card-icon">

                    <i class="bi bi-wrench-adjustable-circle"></i>

                </div>

                <div class="vsc-role-card-content">

                    <h5>
                        My Services
                    </h5>

                    <p>
                        View service requests assigned to you and
                        update service details and status.
                    </p>

                    <a asp-action="MyServices"
                       class="btn btn-primary">

                        <i class="bi bi-tools me-1"></i>

                        My Services

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= INFORMATION ================= -->

    <div class="vsc-admin-info mt-4">

        <div class="d-flex align-items-start gap-3">

            <div class="vsc-info-icon">

                <i class="bi bi-info-circle-fill"></i>

            </div>

            <div>

                <h6 class="mb-1">
                    Mechanic Responsibilities
                </h6>

                <p class="text-muted mb-0">
                    You can view your assigned service requests
                    and update the service description, spare part
                    information and service status.
                </p>

            </div>

        </div>

    </div>

</div>

