@model List<Vehicle_Service_Center.Models.ServiceRequest>

@{
    ViewData["Title"] = "Manage Service Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Service Requests</h2>

        <a asp-action="Create" class="btn btn-primary">
            Create Service Request
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No service requests found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Service Description</th>
                        <th>Spare Parts</th>
                        <th>Mechanic</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var service in Model)
                    {
                        <tr>
                            <td>
                                @(service.Customer?.FullName ?? "N/A")
                            </td>

                            <td>
                                @(service.Vehicle?.VehicleNumberPlate ?? "N/A")
                            </td>

                            <td>
                                @service.ServiceDescription
                            </td>

                            <td>
                                @(service.SparePartUsedDescription ?? "-")
                            </td>

                            <td>
                                @(service.Mechanic?.FullName ?? "Not Assigned")
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @service.Status
                                </span>
                            </td>

                            <td>
                                @service.CreatedAt.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@service.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@service.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this service request?');">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>