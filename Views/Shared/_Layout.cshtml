<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Vehicle Service Center</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Vehicle_Service_Center.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark vsc-navbar">

            <div class="container">

                <!-- Brand -->

                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="vsc-logo">
                        <i class="bi bi-car-front-fill"></i>
                    </span>

                    <span>
                        <strong>Vehicle</strong> Service Center
                    </span>

                </a>


                <!-- Mobile Menu Button -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->

                <div class="navbar-collapse collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">

                        <!-- Home -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Home

                            </a>

                        </li>


                        <!-- Privacy -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">

                                <i class="bi bi-shield-check me-1"></i>
                                Privacy

                            </a>

                        </li>


                        <!-- ADMIN -->

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Admin"
                                   asp-action="Dashboard">

                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard

                                </a>

                            </li>
                        }


                        <!-- MECHANIC -->

                        @if (User.IsInRole("Mechanic"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="MechanicDashboard"
                                   asp-action="Index">

                                    <i class="bi bi-tools me-1"></i>
                                    Dashboard

                                </a>

                            </li>
                        }


                        <!-- CUSTOMER -->

                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="CustomerDashboard"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard

                                </a>

                            </li>
                        }


                        <!-- Login / Profile -->

                        <li class="nav-item vsc-login-area">

                            <partial name="_LoginPartial" />

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ================= MAIN CONTENT ================= -->

    <main role="main">

        <div class="container py-4">

            @RenderBody()

        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="vsc-footer">

        <div class="container">

            <div class="row align-items-center gy-3">

                <div class="col-md-6">

                    <div class="d-flex align-items-center gap-2">

                        <span class="vsc-footer-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </span>

                        <div>

                            <strong>Vehicle Service Center</strong>

                            <div class="small text-muted">
                                Vehicle Service Management System
                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 text-md-end">

                    <div class="small text-muted">

                        &copy; 2026 Vehicle Service Center

                        <span class="mx-2">•</span>

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">
                            Privacy
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
