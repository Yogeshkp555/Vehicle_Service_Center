@model Vehicle_Service_Center.ViewModels.CreateVehicleViewModel

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Add Vehicle</h2>

        <p class="text-muted">
            Add a vehicle for a customer.
        </p>
    </div>

    <div class="row">

        <div class="col-md-6">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">

                    <label asp-for="VehicleNumberPlate"
                           class="form-label"></label>

                    <input asp-for="VehicleNumberPlate"
                           class="form-control" />

                    <span asp-validation-for="VehicleNumberPlate"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="CustomerId"
                           class="form-label">
                        Customer
                    </label>

                    <select asp-for="CustomerId"
                            asp-items="Model.Customers"
                            class="form-select">

                        <option value="">
                            -- Select Customer --
                        </option>

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="VehicleType"
                           class="form-label"></label>

                    <input asp-for="VehicleType"
                           class="form-control"
                           placeholder="Car / Bike / Truck" />

                    <span asp-validation-for="VehicleType"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="VehicleBrand"
                           class="form-label"></label>

                    <input asp-for="VehicleBrand"
                           class="form-control"
                           placeholder="Honda / Toyota / Hyundai" />

                    <span asp-validation-for="VehicleBrand"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="VehicleModel"
                           class="form-label"></label>

                    <input asp-for="VehicleModel"
                           class="form-control"
                           placeholder="City / Swift / Creta" />

                    <span asp-validation-for="VehicleModel"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Issue"
                           class="form-label"></label>

                    <textarea asp-for="Issue"
                              class="form-control"
                              rows="3"
                              placeholder="Describe vehicle issue"></textarea>

                    <span asp-validation-for="Issue"
                          class="text-danger"></span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Add Vehicle
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}